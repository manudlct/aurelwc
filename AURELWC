<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aurel WC 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{
  --bg:#07070d;--bg2:#0f0f1a;--bg3:#181824;--bg4:#1f1f2e;
  --border:#252535;--border2:#2f2f45;
  --accent:#c8f135;--accent2:#3df5a0;
  --red:#ff4d6d;--blue:#4da6ff;--orange:#ff9f43;
  --text:#e8e8f2;--muted:#5a5a7a;--muted2:#8888aa;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh;overflow-x:hidden;}
::-webkit-scrollbar{width:5px;}::-webkit-scrollbar-track{background:var(--bg2);}::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px;}
.mono{font-family:'DM Mono',monospace;}.green{color:var(--accent2);}.red{color:var(--red);}.muted{color:var(--muted2);}.accent{color:var(--accent);}
.hidden{display:none!important;}
input,select{color:var(--text);background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:10px 13px;font-family:'DM Sans',sans-serif;font-size:14px;outline:none;transition:border-color .2s;width:100%;}
input:focus,select:focus{border-color:var(--accent);}
button{cursor:pointer;font-family:'DM Sans',sans-serif;}
.loading{color:var(--muted2);padding:32px;text-align:center;font-style:italic;}

/* AUTH */
#auth-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:radial-gradient(ellipse 700px 400px at 20% 60%,rgba(200,241,53,.04),transparent),
             radial-gradient(ellipse 500px 300px at 80% 30%,rgba(61,245,160,.03),transparent),var(--bg);
  position:relative;overflow:hidden;}
#auth-screen::before{content:'AUREL WC';position:absolute;font-family:'Bebas Neue',sans-serif;
  font-size:20vw;color:rgba(200,241,53,.025);letter-spacing:.15em;
  top:50%;left:50%;transform:translate(-50%,-50%);white-space:nowrap;pointer-events:none;}
.auth-card{background:var(--bg2);border:1px solid var(--border2);border-radius:20px;padding:44px;width:440px;
  position:relative;z-index:1;box-shadow:0 40px 100px rgba(0,0,0,.6);}
.auth-logo{font-family:'Bebas Neue',sans-serif;font-size:48px;letter-spacing:.1em;color:var(--accent);}
.auth-sub{font-family:'DM Mono',monospace;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.15em;margin-top:4px;margin-bottom:32px;}
.tab-row{display:flex;border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:24px;}
.tab-btn{flex:1;padding:10px;background:none;border:none;color:var(--muted);font-size:13px;font-weight:500;transition:all .2s;}
.tab-btn.active{background:var(--accent);color:#000;font-weight:700;}
.fgroup{margin-bottom:14px;}
.fgroup label{display:block;font-size:10px;font-family:'DM Mono',monospace;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;margin-bottom:5px;}
.pay-box{background:rgba(200,241,53,.05);border:1px solid rgba(200,241,53,.2);border-radius:10px;padding:14px;margin:14px 0;}
.pay-box .pb-label{font-family:'DM Mono',monospace;font-size:10px;color:var(--accent);text-transform:uppercase;letter-spacing:.12em;margin-bottom:8px;}
.pay-box p{font-size:13px;color:var(--muted2);line-height:1.7;}
.pay-box strong{color:var(--text);}
.pending-tag{display:inline-flex;align-items:center;gap:6px;background:rgba(255,159,67,.1);border:1px solid rgba(255,159,67,.3);color:var(--orange);border-radius:20px;padding:5px 12px;font-size:11px;font-family:'DM Mono',monospace;margin-top:12px;}
.dot{width:6px;height:6px;border-radius:50%;background:var(--orange);animation:pulse 1.4s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.3;}}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 18px;border-radius:9px;border:none;font-size:13px;font-weight:600;transition:all .15s;text-align:center;}
.btn:hover{opacity:.85;transform:translateY(-1px);}
.btn:active{transform:translateY(0);}
.btn-full{width:100%;}
.btn-primary{background:var(--accent);color:#000;}
.btn-secondary{background:var(--bg3);color:var(--text);border:1px solid var(--border2);}
.btn-danger{background:var(--red);color:#fff;}
.btn-ghost{background:transparent;color:var(--muted2);border:1px solid var(--border);}
.btn-buy{background:rgba(61,245,160,.12);color:var(--accent2);border:1px solid rgba(61,245,160,.25);}
.btn-buy:hover{background:rgba(61,245,160,.22);}
.btn-sell{background:rgba(255,77,109,.12);color:var(--red);border:1px solid rgba(255,77,109,.25);}
.btn-sell:hover{background:rgba(255,77,109,.22);}
.btn-sm{padding:8px 14px;font-size:12px;}
.btn-xs{padding:5px 10px;font-size:11px;border-radius:6px;}

/* TOPBAR */
#app{display:none;flex-direction:column;min-height:100vh;}
.topbar{position:sticky;top:0;z-index:200;background:rgba(7,7,13,.97);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 20px;height:52px;gap:4px;}
.topbar-logo{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:.1em;color:var(--accent);margin-right:12px;flex-shrink:0;}
.nav-btn{padding:6px 12px;background:none;border:none;color:var(--muted2);font-size:13px;font-weight:500;border-radius:7px;transition:all .2s;}
.nav-btn:hover{color:var(--text);background:var(--bg3);}
.nav-btn.active{color:var(--accent);background:rgba(200,241,53,.08);}
.tb-right{display:flex;align-items:center;gap:12px;margin-left:auto;}
.wallet-pill{display:flex;align-items:center;gap:8px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:6px 14px;font-family:'DM Mono',monospace;font-size:13px;}
.wallet-pill .wp-shares{color:var(--accent);}
.notif-btn{position:relative;background:none;border:none;color:var(--muted2);font-size:18px;padding:4px 8px;border-radius:7px;}
.notif-btn:hover{color:var(--text);}
.notif-badge{position:absolute;top:0;right:0;background:var(--red);color:#fff;border-radius:50%;width:16px;height:16px;font-size:9px;display:flex;align-items:center;justify-content:center;font-family:'DM Mono',monospace;}
.notif-panel{position:absolute;top:54px;right:0;width:340px;background:var(--bg2);border:1px solid var(--border2);border-radius:12px;z-index:300;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.6);}
.notif-panel-header{padding:12px 16px;border-bottom:1px solid var(--border);font-size:12px;font-weight:600;color:var(--muted2);text-transform:uppercase;letter-spacing:.08em;}
.notif-item{padding:12px 16px;border-bottom:1px solid var(--border);font-size:13px;cursor:pointer;transition:background .15s;}
.notif-item:hover{background:var(--bg3);}
.tb-user{font-size:13px;font-weight:600;color:var(--text);}

/* PAGES */
.page{padding:24px;max-width:1400px;margin:0 auto;flex:1;}
.page-title{font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:.08em;color:var(--accent);margin-bottom:24px;}
.section-title{font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:var(--muted2);margin-bottom:12px;}

/* PENDING */
#pending-screen{min-height:100vh;display:none;align-items:center;justify-content:center;background:var(--bg);}
.pending-card{background:var(--bg2);border:1px solid var(--border2);border-radius:20px;padding:44px;width:460px;text-align:center;box-shadow:0 40px 100px rgba(0,0,0,.5);}
.pending-icon{font-size:48px;margin-bottom:16px;}
.pending-card h2{font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:.08em;color:var(--accent);margin-bottom:8px;}

/* MARKETS */
.group-section{margin-bottom:28px;}
.group-label{font-family:'DM Mono',monospace;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;margin-bottom:10px;padding-left:4px;}
.team-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px;}
.team-card{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:16px;cursor:pointer;transition:all .2s;}
.team-card:hover{border-color:var(--border2);background:var(--bg3);transform:translateY(-2px);}
.team-card.resolved{opacity:.6;}
.tc-flag{font-size:26px;margin-bottom:6px;}
.tc-name{font-size:13px;font-weight:600;margin-bottom:8px;line-height:1.2;}
.tc-price{font-size:22px;font-weight:700;font-family:'DM Mono',monospace;margin-bottom:4px;}
.tc-change{font-size:11px;font-family:'DM Mono',monospace;}
.tc-actions{display:flex;gap:6px;margin-top:10px;}
.res-badge{background:rgba(200,241,53,.1);color:var(--accent);border-radius:6px;padding:3px 8px;font-size:13px;font-family:'DM Mono',monospace;}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.8);backdrop-filter:blur(8px);z-index:500;display:flex;align-items:center;justify-content:center;padding:20px;}
.modal-box{background:var(--bg2);border:1px solid var(--border2);border-radius:16px;width:100%;max-width:900px;max-height:90vh;overflow-y:auto;display:flex;flex-direction:column;}
.modal-header{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--bg2);z-index:10;}
.modal-title{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:.08em;}
.modal-close{background:none;border:none;color:var(--muted2);font-size:20px;padding:4px 8px;border-radius:7px;}
.modal-close:hover{color:var(--text);}
.modal-body{padding:20px 24px;display:grid;grid-template-columns:1fr 1fr;gap:20px;}
.modal-col{display:flex;flex-direction:column;gap:16px;}
.col-title{font-size:11px;font-family:'DM Mono',monospace;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;margin-bottom:8px;}

/* ORDERBOOK */
.orderbook{background:var(--bg3);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
.ob-header{display:grid;grid-template-columns:60px 60px 1fr auto;padding:8px 12px;border-bottom:1px solid var(--border);font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;font-family:'DM Mono',monospace;}
.ob-row{display:grid;grid-template-columns:60px 60px 1fr auto;align-items:center;gap:8px;padding:7px 12px;border-bottom:1px solid rgba(37,37,53,.5);font-size:12px;}
.ob-row.ask{background:rgba(255,77,109,.03);}
.ob-row.bid{background:rgba(61,245,160,.03);}
.ob-spread{padding:6px 12px;text-align:center;font-size:11px;font-family:'DM Mono',monospace;color:var(--muted);background:var(--bg);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.ob-user{font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ob-empty{padding:20px;text-align:center;color:var(--muted);font-size:13px;}
.chart-box{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:14px;height:200px;position:relative;}
.chat-box{background:var(--bg3);border:1px solid var(--border);border-radius:10px;overflow:hidden;display:flex;flex-direction:column;}
.chat-messages{flex:1;padding:12px;min-height:160px;max-height:220px;overflow-y:auto;display:flex;flex-direction:column;gap:6px;}
.chat-msg{font-size:13px;display:flex;gap:8px;align-items:baseline;flex-wrap:wrap;}
.chat-msg.me{justify-content:flex-end;}
.chat-pseudo{font-weight:600;font-size:11px;flex-shrink:0;}
.chat-text{color:var(--text);line-height:1.4;}
.chat-input-row{display:flex;gap:8px;padding:10px 12px;border-top:1px solid var(--border);}
.chat-input-row input{flex:1;padding:8px 12px;font-size:13px;}
.order-modal{max-width:420px;}
.order-warning{font-size:12px;font-family:'DM Mono',monospace;margin-top:6px;line-height:1.7;min-height:20px;}

/* PORTFOLIO */
.port-wallet{background:linear-gradient(135deg,rgba(200,241,53,.08),rgba(200,241,53,.02));border:1px solid rgba(200,241,53,.2);border-radius:14px;padding:24px;margin-bottom:24px;}
.pw-label{font-size:11px;font-family:'DM Mono',monospace;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;margin-bottom:8px;}
.pw-val{font-size:36px;font-weight:700;color:var(--accent);}
.pw-eur{font-size:14px;margin-top:4px;}
.positions-list,.orders-list{display:flex;flex-direction:column;gap:8px;}
.position-row,.order-row{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:14px 16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;font-size:13px;}
.side-badge{font-size:11px;font-family:'DM Mono',monospace;font-weight:700;padding:3px 8px;border-radius:5px;}
.side-badge.long{background:rgba(61,245,160,.1);color:var(--accent2);}
.side-badge.short{background:rgba(255,77,109,.1);color:var(--red);}

/* HISTORY */
.netting-box{background:var(--bg2);border:1px solid var(--border2);border-radius:12px;overflow:hidden;margin-bottom:20px;}
.netting-row{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--border);font-size:14px;}
.netting-row:last-child{border-bottom:none;}
.trade-list{display:flex;flex-direction:column;gap:8px;}
.trade-row{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:14px 16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;font-size:13px;}

/* LEADERBOARD */
.leaderboard-list{display:flex;flex-direction:column;gap:8px;max-width:600px;}
.lb-row{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:14px 20px;display:flex;align-items:center;gap:16px;font-size:14px;}
.lb-row.lb-me{border-color:rgba(200,241,53,.4);background:rgba(200,241,53,.04);}
.lb-rank{font-size:20px;width:32px;flex-shrink:0;}
.lb-pseudo{font-weight:600;flex:1;}
.lb-shares{font-size:16px;font-weight:700;color:var(--accent);}

/* ADMIN */
.admin-section{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:16px;}
.admin-list{display:flex;flex-direction:column;gap:8px;margin-top:12px;}
.admin-row{background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:13px;}
.admin-form{display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;margin-top:12px;}
.admin-form .fgroup{margin-bottom:0;flex:1;min-width:150px;}
.resol-grid{display:flex;flex-direction:column;gap:5px;font-size:12px;font-family:'DM Mono',monospace;}
.resol-row{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid rgba(37,37,53,.5);}
.resol-row:last-child{border-bottom:none;}

/* TOAST */
#toast-container{position:fixed;bottom:24px;right:24px;z-index:1000;display:flex;flex-direction:column;gap:8px;pointer-events:none;}
.toast{background:var(--bg3);border:1px solid var(--border2);border-radius:10px;padding:12px 18px;font-size:13px;font-weight:500;transform:translateX(120%);transition:transform .3s ease;box-shadow:0 8px 32px rgba(0,0,0,.4);pointer-events:all;}
.toast.show{transform:translateX(0);}
.toast-success{border-color:rgba(61,245,160,.4);color:var(--accent2);}
.toast-error{border-color:rgba(255,77,109,.4);color:var(--red);}
.toast-info{border-color:var(--border2);color:var(--text);}

@media(max-width:768px){
  .modal-body{grid-template-columns:1fr;}
  .auth-card{width:95%;padding:28px;}
  .page{padding:14px;}
  .topbar{padding:0 10px;gap:2px;}
  .nav-btn{padding:5px 7px;font-size:11px;}
  .topbar-logo{font-size:20px;}
}
</style>
</head>
<body>

<!-- AUTH -->
<div id="auth-screen">
  <div class="auth-card">
    <div class="auth-logo">Aurel WC</div>
    <div class="auth-sub">World Cup 2026 — Trading Platform</div>
    <div class="tab-row">
      <button class="tab-btn active" id="tab-login" onclick="authTab('login')">Connexion</button>
      <button class="tab-btn" id="tab-register" onclick="authTab('register')">Inscription</button>
    </div>
    <div id="form-login">
      <div class="fgroup"><label>Email</label><input type="email" id="login-email" placeholder="ton@email.com"></div>
      <div class="fgroup"><label>Mot de passe</label><input type="password" id="login-pass" placeholder="••••••••"></div>
      <button class="btn btn-primary btn-full" id="btn-login" onclick="doLogin()" style="margin-top:8px">Se connecter</button>
    </div>
    <div id="form-register" class="hidden">
      <div class="fgroup"><label>Pseudo (visible par tous)</label><input type="text" id="reg-pseudo" placeholder="JohnTrader"></div>
      <div class="fgroup"><label>Email</label><input type="email" id="reg-email" placeholder="ton@email.com"></div>
      <div class="fgroup"><label>Mot de passe</label><input type="password" id="reg-pass" placeholder="••••••••"></div>
      <div class="fgroup">
        <label>Mise de départ (€ — min. 5€)</label>
        <input type="number" id="reg-amount" value="5" min="5" step="5">
      </div>
      <div class="pay-box">
        <div class="pb-label">💸 Paiement par Lydia</div>
        <p>Envoie le montant à <strong>Aurel sur Lydia</strong> avec ton pseudo en commentaire.<br>
        Compte activé dès réception.<br><br>
        <strong>5€ = 250 shares &nbsp;·&nbsp; 1 share = 1€</strong></p>
      </div>
      <button class="btn btn-primary btn-full" id="btn-register" onclick="doRegister()">S'inscrire</button>
    </div>
  </div>
</div>

<!-- PENDING -->
<div id="pending-screen">
  <div class="pending-card">
    <div class="pending-icon">⏳</div>
    <h2>En attente de validation</h2>
    <p style="color:var(--muted2);margin-top:12px;line-height:1.7;font-size:14px">
      Salut <strong id="pending-pseudo">—</strong> !<br>
      Envoie <strong id="pending-amount">—</strong> à <strong>Aurel sur Lydia</strong><br>
      avec ton pseudo en commentaire.<br><br>
      Tu recevras <strong id="pending-shares">—</strong> dès validation.
    </p>
    <div class="pending-tag"><div class="dot"></div>En attente du paiement Lydia</div>
    <br><br>
    <button class="btn btn-ghost btn-sm" onclick="doLogout()">Se déconnecter</button>
  </div>
</div>

<!-- APP -->
<div id="app">
  <div class="topbar">
    <div class="topbar-logo">Aurel WC</div>
    <button class="nav-btn active" data-page="markets" onclick="navigateTo('markets')">Marchés</button>
    <button class="nav-btn" data-page="portfolio" onclick="navigateTo('portfolio')">Portfolio</button>
    <button class="nav-btn" data-page="history" onclick="navigateTo('history')">Historique</button>
    <button class="nav-btn" data-page="leaderboard" onclick="navigateTo('leaderboard')">🏆 Classement</button>
    <button class="nav-btn hidden" data-page="admin" id="btn-admin-nav" onclick="navigateTo('admin')">⚙️ Admin</button>
    <div class="tb-right">
      <div class="wallet-pill">
        <span class="muted mono" style="font-size:10px">SHARES</span>
        <span class="wp-shares" id="tb-shares">0</span>
      </div>
      <span class="tb-user" id="tb-pseudo"></span>
      <div style="position:relative">
        <button class="notif-btn" onclick="toggleNotifs()">🔔<span class="notif-badge hidden" id="notif-badge"></span></button>
        <div class="notif-panel hidden" id="notif-panel">
          <div class="notif-panel-header">Notifications</div>
          <div id="notif-list"></div>
        </div>
      </div>
      <button class="btn btn-ghost btn-xs" onclick="doLogout()">Quitter</button>
    </div>
  </div>
  <div id="page-markets" class="page"><div class="page-title">Marchés WC 2026</div><div id="market-grid"></div></div>
  <div id="page-portfolio" class="page hidden"><div class="page-title">Mon Portfolio</div><div id="portfolio-content"></div></div>
  <div id="page-history" class="page hidden"><div class="page-title">Historique & Règlement</div><div id="history-content"></div></div>
  <div id="page-leaderboard" class="page hidden"><div class="page-title">🏆 Classement</div><div id="leaderboard-content"></div></div>
  <div id="page-admin" class="page hidden"><div class="page-title">⚙️ Panel Admin</div><div id="admin-content"></div></div>
</div>

<!-- TEAM MODAL -->
<div id="team-modal" class="modal-overlay hidden" onclick="if(event.target===this)closeTeamModal()">
  <div class="modal-box">
    <div class="modal-header">
      <div class="modal-title" id="modal-team-name">—</div>
      <div style="display:flex;gap:8px;align-items:center">
        <button class="btn btn-buy btn-sm" onclick="openOrder(selectedTeam,'buy')">🟢 BUY</button>
        <button class="btn btn-sell btn-sm" onclick="openOrder(selectedTeam,'sell')">🔴 SELL</button>
        <button class="modal-close" onclick="closeTeamModal()">✕</button>
      </div>
    </div>
    <div class="modal-body">
      <div class="modal-col">
        <div>
          <div class="col-title">Carnet d'ordres</div>
          <div class="orderbook">
