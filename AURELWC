<script>
/* ══════════════════════════════════════════════════
   🔧 SUPABASE CONFIG
   Remplace ces deux valeurs par les tiennes
   ══════════════════════════════════════════════════ */
const SUPABASE_URL = 'https://urzeaesixkbmpychczny.supabase.co';
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVyemVhZXNpeGtibXB5Y2hjem55Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzE2ODYyMjYsImV4cCI6MjA4NzI2MjIyNn0.qQGpIlEIKrHsIOY5bLUHEBxlS5rzlNIKjcg2UaRHqSc';

/* ══════ CONSTANTES ══════ */
const SHARES_PER_EUR = 50;
const MIN_EUR = 5;
const ADMIN_EMAIL = 'manu.delcourt@hotmail.fr'; // ← TON email ici
const RESOLUTION = { champion:100, finalist:75, semi:55, quarter:35, r16:10, groups:0 };

const TEAMS = [
  {id:'USA',name:'États-Unis',flag:'🇺🇸',group:'A'},{id:'MEX',name:'Mexique',flag:'🇲🇽',group:'A'},
  {id:'CAN',name:'Canada',flag:'🇨🇦',group:'A'},{id:'MAR',name:'Maroc',flag:'🇲🇦',group:'A'},
  {id:'ARG',name:'Argentine',flag:'🇦🇷',group:'B'},{id:'BRA',name:'Brésil',flag:'🇧🇷',group:'B'},
  {id:'URU',name:'Uruguay',flag:'🇺🇾',group:'B'},{id:'ECU',name:'Équateur',flag:'🇪🇨',group:'B'},
  {id:'FRA',name:'France',flag:'🇫🇷',group:'C'},{id:'ENG',name:'Angleterre',flag:'🏴󠁧󠁢󠁥󠁮󠁧󠁿',group:'C'},
  {id:'GER',name:'Allemagne',flag:'🇩🇪',group:'C'},{id:'POR',name:'Portugal',flag:'🇵🇹',group:'C'},
  {id:'ESP',name:'Espagne',flag:'🇪🇸',group:'D'},{id:'NED',name:'Pays-Bas',flag:'🇳🇱',group:'D'},
  {id:'BEL',name:'Belgique',flag:'🇧🇪',group:'D'},{id:'CRO',name:'Croatie',flag:'🇭🇷',group:'D'},
  {id:'SEN',name:'Sénégal',flag:'🇸🇳',group:'E'},{id:'NGA',name:'Nigeria',flag:'🇳🇬',group:'E'},
  {id:'CMR',name:'Cameroun',flag:'🇨🇲',group:'E'},{id:'CIV',name:"Côte d'Ivoire",flag:'🇨🇮',group:'E'},
  {id:'JPN',name:'Japon',flag:'🇯🇵',group:'F'},{id:'KOR',name:'Corée du Sud',flag:'🇰🇷',group:'F'},
  {id:'AUS',name:'Australie',flag:'🇦🇺',group:'F'},{id:'IRN',name:'Iran',flag:'🇮🇷',group:'F'},
  {id:'DEN',name:'Danemark',flag:'🇩🇰',group:'G'},{id:'SUI',name:'Suisse',flag:'🇨🇭',group:'G'},
  {id:'AUT',name:'Autriche',flag:'🇦🇹',group:'G'},{id:'SRB',name:'Serbie',flag:'🇷🇸',group:'G'},
  {id:'COL',name:'Colombie',flag:'🇨🇴',group:'H'},{id:'PER',name:'Pérou',flag:'🇵🇪',group:'H'},
  {id:'VEN',name:'Venezuela',flag:'🇻🇪',group:'H'},{id:'CHL',name:'Chili',flag:'🇨🇱',group:'H'},
  {id:'ITA',name:'Italie',flag:'🇮🇹',group:'I'},{id:'UKR',name:'Ukraine',flag:'🇺🇦',group:'I'},
  {id:'POL',name:'Pologne',flag:'🇵🇱',group:'I'},{id:'CZE',name:'Tchéquie',flag:'🇨🇿',group:'I'},
  {id:'TUR',name:'Turquie',flag:'🇹🇷',group:'J'},{id:'HUN',name:'Hongrie',flag:'🇭🇺',group:'J'},
  {id:'SLO',name:'Slovaquie',flag:'🇸🇰',group:'J'},{id:'SCO',name:'Écosse',flag:'🏴󠁧󠁢󠁳󠁣󠁴󠁿',group:'J'},
  {id:'GHA',name:'Ghana',flag:'🇬🇭',group:'K'},{id:'EGY',name:'Égypte',flag:'🇪🇬',group:'K'},
  {id:'TUN',name:'Tunisie',flag:'🇹🇳',group:'K'},{id:'ALG',name:'Algérie',flag:'🇩🇿',group:'K'},
  {id:'MEX2',name:'Mexique B',flag:'🇲🇽',group:'L'},{id:'PAR',name:'Paraguay',flag:'🇵🇾',group:'L'},
  {id:'BOL',name:'Bolivie',flag:'🇧🇴',group:'L'},{id:'PAN',name:'Panama',flag:'🇵🇦',group:'L'},
];

/* ══════ INIT SUPABASE ══════ */
const { createClient } = supabase;
const sb = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

let currentUser = null;
let currentProfile = null;
let currentPage = 'markets';
let selectedTeam = null;
let obChannel = null;
let chatChannel = null;
let notifChannel = null;
let priceChartInstance = null;

/* ══════ AUTH STATE ══════ */
sb.auth.onAuthStateChange(async (event, session) => {
  if (session?.user) {
    currentUser = session.user;
    const { data } = await sb.from('profiles').select('*').eq('id', currentUser.id).single();
    currentProfile = data;
    if (!currentProfile || currentProfile.status === 'pending') showPendingScreen();
    else startApp();
  } else {
    currentUser = null; currentProfile = null;
    showAuthScreen();
  }
});

function showAuthScreen() {
  document.getElementById('auth-screen').style.display = 'flex';
  document.getElementById('app').style.display = 'none';
  document.getElementById('pending-screen').style.display = 'none';
}

function showPendingScreen() {
  document.getElementById('auth-screen').style.display = 'none';
  document.getElementById('app').style.display = 'none';
  document.getElementById('pending-screen').style.display = 'flex';
  if (currentProfile) {
    document.getElementById('pending-pseudo').textContent = currentProfile.pseudo;
    document.getElementById('pending-amount').textContent = currentProfile.pending_eur + '€';
    document.getElementById('pending-shares').textContent = currentProfile.pending_shares + ' shares';
  }
}

async function startApp() {
  document.getElementById('auth-screen').style.display = 'none';
  document.getElementById('pending-screen').style.display = 'none';
  document.getElementById('app').style.display = 'flex';
  const { data } = await sb.from('profiles').select('*').eq('id', currentUser.id).single();
  currentProfile = data;
  updateTopbar();
  navigateTo('markets');
  subscribeNotifications();
}

/* ══════ AUTH ACTIONS ══════ */
function authTab(tab) {
  document.getElementById('tab-login').classList.toggle('active', tab === 'login');
  document.getElementById('tab-register').classList.toggle('active', tab === 'register');
  document.getElementById('form-login').classList.toggle('hidden', tab !== 'login');
  document.getElementById('form-register').classList.toggle('hidden', tab !== 'register');
}

async function doLogin() {
  const email = document.getElementById('login-email').value.trim();
  const pass = document.getElementById('login-pass').value;
  const btn = document.getElementById('btn-login');
  btn.textContent = 'Connexion...'; btn.disabled = true;
  const { error } = await sb.auth.signInWithPassword({ email, password: pass });
  if (error) { toast('Email ou mot de passe incorrect', 'error'); btn.textContent = 'Se connecter'; btn.disabled = false; }
}

async function doRegister() {
  const pseudo = document.getElementById('reg-pseudo').value.trim();
  const email = document.getElementById('reg-email').value.trim();
  const pass = document.getElementById('reg-pass').value;
  const amount = parseInt(document.getElementById('reg-amount').value) || 0;
  if (!pseudo || !email || !pass) { toast('Remplis tous les champs', 'error'); return; }
  if (amount < MIN_EUR) { toast('Minimum ' + MIN_EUR + '€', 'error'); return; }
  const btn = document.getElementById('btn-register');
  btn.textContent = 'Inscription...'; btn.disabled = true;
  const { data, error } = await sb.auth.signUp({ email, password: pass });
  if (error) { toast('Email déjà utilisé ou erreur', 'error'); btn.textContent = "S'inscrire"; btn.disabled = false; return; }
  const shares = amount * SHARES_PER_EUR;
  await sb.from('profiles').insert({
    id: data.user.id, pseudo, email, shares: 0,
    pending_shares: shares, pending_eur: amount,
    status: 'pending', is_admin: email.toLowerCase() === ADMIN_EMAIL.toLowerCase()
  });
  currentProfile = { pseudo, pending_eur: amount, pending_shares: shares, status: 'pending' };
  showPendingScreen();
}

async function doLogout() {
  if (obChannel) sb.removeChannel(obChannel);
  if (chatChannel) sb.removeChannel(chatChannel);
  if (notifChannel) sb.removeChannel(notifChannel);
  await sb.auth.signOut();
}

/* ══════ NAVIGATION ══════ */
function navigateTo(page) {
  currentPage = page;
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.toggle('active', b.dataset.page === page));
  ['markets','portfolio','history','leaderboard','admin'].forEach(p => {
    document.getElementById('page-' + p)?.classList.toggle('hidden', p !== page);
  });
  if (page === 'markets') renderMarkets();
  if (page === 'portfolio') renderPortfolio();
  if (page === 'history') renderHistory();
  if (page === 'leaderboard') renderLeaderboard();
  if (page === 'admin' && currentProfile?.is_admin) renderAdmin();
}

function updateTopbar() {
  document.getElementById('tb-pseudo').textContent = currentProfile?.pseudo || '';
  document.getElementById('tb-shares').textContent = (currentProfile?.shares || 0).toLocaleString('fr');
  document.getElementById('btn-admin-nav')?.classList.toggle('hidden', !currentProfile?.is_admin);
}

/* ══════ MARKETS ══════ */
async function renderMarkets() {
  const grid = document.getElementById('market-grid');
  grid.innerHTML = '<div class="loading">Chargement des marchés...</div>';
  const [{ data: prices }, { data: resolved }] = await Promise.all([
    sb.from('market_prices').select('*'),
    sb.from('resolved_markets').select('*')
  ]);
  const pricesMap = {}, resolvedMap = {};
  (prices || []).forEach(p => pricesMap[p.team_id] = p);
  (resolved || []).forEach(r => resolvedMap[r.team_id] = r);

  const groups = [...new Set(TEAMS.map(t => t.group))];
  let html = '';
  groups.forEach(g => {
    html += '<div class="group-section"><div class="group-label">Groupe ' + g + '</div><div class="team-cards">';
    TEAMS.filter(t => t.group === g).forEach(team => {
      const p = pricesMap[team.id];
      const lastPrice = p?.last_price ?? null;
      const res = resolvedMap[team.id];
      const resVal = res ? RESOLUTION[res.stage] : null;
      html += '<div class="team-card' + (res ? ' resolved' : '') + '" onclick="openTeam(\'' + team.id + '\')">' +
        '<div class="tc-flag">' + team.flag + '</div>' +
        '<div class="tc-name">' + team.name + '</div>' +
        '<div class="tc-price">' + (res ? '<span class="res-badge">' + resVal + ' ✓</span>' : lastPrice !== null ? '<span>' + lastPrice + '</span>' : '<span class="muted">—</span>') + '</div>' +
        (!res ? '<div class="tc-actions">' +
          '<button class="btn btn-buy btn-xs" onclick="event.stopPropagation();openOrder(\'' + team.id + '\',\'buy\')">BUY</button>' +
          '<button class="btn btn-sell btn-xs" onclick="event.stopPropagation();openOrder(\'' + team.id + '\',\'sell\')">SELL</button>' +
          '</div>' : '') +
        '</div>';
    });
    html += '</div></div>';
  });
  grid.innerHTML = html;
}

/* ══════ TEAM MODAL ══════ */
async function openTeam(teamId) {
  selectedTeam = teamId;
  const team = TEAMS.find(t => t.id === teamId);
  document.getElementById('modal-team-name').textContent = team.flag + ' ' + team.name;
  document.getElementById('team-modal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
  if (obChannel) sb.removeChannel(obChannel);
  if (chatChannel) sb.removeChannel(chatChannel);
  if (priceChartInstance) { priceChartInstance.destroy(); priceChartInstance = null; }
  subscribeOrderbook(teamId);
  subscribeChat(teamId);
  renderPriceChart(teamId);
}

function closeTeamModal() {
  document.getElementById('team-modal').classList.add('hidden');
  document.body.style.overflow = '';
  if (obChannel) { sb.removeChannel(obChannel); obChannel = null; }
  if (chatChannel) { sb.removeChannel(chatChannel); chatChannel = null; }
  if (priceChartInstance) { priceChartInstance.destroy(); priceChartInstance = null; }
}

/* ══════ ORDERBOOK ══════ */
async function subscribeOrderbook(teamId) {
  await renderOrderbook(teamId);
  obChannel = sb.channel('orders-' + teamId)
    .on('postgres_changes', { event: '*', schema: 'public', table: 'orders', filter: 'team_id=eq.' + teamId }, () => renderOrderbook(teamId))
    .subscribe();
}

async function renderOrderbook(teamId) {
  const [{ data: bids }, { data: asks }] = await Promise.all([
    sb.from('orders').select('*').eq('team_id', teamId).eq('side', 'buy').eq('status', 'open').order('price', { ascending: false }).limit(10),
    sb.from('orders').select('*').eq('team_id', teamId).eq('side', 'sell').eq('status', 'open').order('price', { ascending: true }).limit(10)
  ]);
  const bidsEl = document.getElementById('ob-bids');
  const asksEl = document.getElementById('ob-asks');
  const spreadEl = document.getElementById('ob-spread');
  if (!bidsEl) return;
  if (!bids?.length && !asks?.length) {
    asksEl.innerHTML = ''; bidsEl.innerHTML = '<div class="ob-empty">Aucun ordre — sois le premier !</div>';
    spreadEl.textContent = 'Spread: —'; return;
  }
  const bb = bids?.[0]?.price, ba = asks?.[0]?.price;
  spreadEl.textContent = bb && ba ? 'Spread: ' + (ba - bb) + ' · Mid: ' + ((bb + ba) / 2).toFixed(1) : 'Spread: —';
  const makeRow = (o, side) => {
    const isMe = o.user_id === currentUser?.id;
    const action = isMe
      ? '<button class="btn btn-xs btn-ghost" onclick="cancelOrder(\'' + o.id + '\')">✕</button>'
      : side === 'ask'
        ? '<button class="btn btn-xs btn-buy" onclick="fillOrder(\'' + o.id + '\',\'buy\')">MATCH</button>'
        : '<button class="btn btn-xs btn-sell" onclick="fillOrder(\'' + o.id + '\',\'sell\')">MATCH</button>';
    return '<div class="ob-row ' + side + '">' +
      '<span class="mono ' + (side === 'ask' ? 'red' : 'green') + '">' + o.price + '</span>' +
      '<span class="mono">' + o.remaining + '</span>' +
      '<span class="ob-user muted">' + esc(o.pseudo) + '</span>' +
      action + '</div>';
  };
  asksEl.innerHTML = [...(asks || [])].reverse().map(o => makeRow(o, 'ask')).join('');
  bidsEl.innerHTML = (bids || []).map(o => makeRow(o, 'bid')).join('');
}

/* ══════ PRICE CHART ══════ */
async function renderPriceChart(teamId) {
  const canvas = document.getElementById('price-chart');
  if (!canvas) return;
  const { data } = await sb.from('trades').select('price, created_at').eq('team_id', teamId).neq('status', 'cancelled').order('created_at', { ascending: true }).limit(100);
  if (!data?.length) {
    canvas.parentElement.innerHTML = '<p class="muted" style="text-align:center;padding-top:70px;font-size:13px">Aucun trade encore</p>'; return;
  }
  priceChartInstance = new Chart(canvas, {
    type: 'line',
    data: {
      labels: data.map(t => new Date(t.created_at).toLocaleDateString('fr')),
      datasets: [{ data: data.map(t => t.price), fill: true, borderColor: '#c8f135', backgroundColor: 'rgba(200,241,53,.06)', pointRadius: 3, pointBackgroundColor: '#c8f135', tension: .35 }]
    },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
      scales: { x: { ticks: { color: '#5a5a7a', font: { size: 10 } }, grid: { color: '#1a1a24' } }, y: { ticks: { color: '#5a5a7a' }, grid: { color: '#1a1a24' }, min: 0, max: 100 } } }
  });
}

/* ══════ ORDER PLACEMENT ══════ */
function openOrder(teamId, side) {
  selectedTeam = teamId;
  const team = TEAMS.find(t => t.id === teamId);
  document.getElementById('order-modal-title').textContent = (side === 'buy' ? '🟢 ACHETER' : '🔴 VENDRE') + ' — ' + team.flag + ' ' + team.name;
  document.getElementById('order-side').value = side;
  document.getElementById('order-teamid').value = teamId;
  document.getElementById('order-price').value = '';
  document.getElementById('order-qty').value = '1';
  document.getElementById('order-warning').innerHTML = '';
  document.getElementById('order-modal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}

function closeOrderModal() {
  document.getElementById('order-modal').classList.add('hidden');
  document.body.style.overflow = '';
}

function calcOrderWarning() {
  const price = parseFloat(document.getElementById('order-price').value) || 0;
  const qty = parseInt(document.getElementById('order-qty').value) || 0;
  const side = document.getElementById('order-side').value;
  const w = document.getElementById('order-warning');
  if (!price || !qty) { w.innerHTML = ''; return; }
  const maxGain = side === 'buy' ? (100 - price) * qty : price * qty;
  const maxLoss = side === 'buy' ? price * qty : (100 - price) * qty;
  w.innerHTML = '<span class="green">Gain max: +' + maxGain + ' shares (+' + maxGain + '€)</span><br>' +
    '<span class="red">Perte max: -' + maxLoss + ' shares (-' + maxLoss + '€)</span><br>' +
    '<span class="muted">Escrow bloqué: ' + maxLoss + ' shares</span>';
}

async function submitOrder() {
  const price = parseFloat(document.getElementById('order-price').value);
  const qty = parseInt(document.getElementById('order-qty').value);
  const side = document.getElementById('order-side').value;
  const teamId = document.getElementById('order-teamid').value;
  if (!price || price < 1 || price > 99) { toast('Prix entre 1 et 99', 'error'); return; }
  if (!qty || qty < 1) { toast('Quantité minimum 1', 'error'); return; }
  const escrow = side === 'buy' ? price * qty : (100 - price) * qty;
  if ((currentProfile.shares || 0) < escrow) { toast('Solde insuffisant. Requis: ' + escrow + ' shares', 'error'); return; }
  const btn = document.getElementById('btn-submit-order');
  btn.textContent = 'Envoi...'; btn.disabled = true;
  const { error: e1 } = await sb.from('profiles').update({ shares: currentProfile.shares - escrow }).eq('id', currentUser.id);
  if (e1) { toast('Erreur: ' + e1.message, 'error'); btn.textContent = '✓ Confirmer'; btn.disabled = false; return; }
  const { error: e2 } = await sb.from('orders').insert({ user_id: currentUser.id, pseudo: currentProfile.pseudo, team_id: teamId, side, price, qty, remaining: qty, escrow, status: 'open' });
  if (e2) { toast('Erreur: ' + e2.message, 'error'); } else {
    currentProfile.shares -= escrow;
    updateTopbar(); toast('Ordre placé ✓', 'success'); closeOrderModal();
  }
  btn.textContent = '✓ Confirmer l\'ordre'; btn.disabled = false;
}

/* ══════ FILL ORDER ══════ */
async function fillOrder(orderId, myRole) {
  const { data: order } = await sb.from('orders').select('*').eq('id', orderId).single();
  if (!order || order.status !== 'open') { toast('Ordre indisponible', 'error'); return; }
  if (order.user_id === currentUser.id) { toast('Tu ne peux pas matcher ton propre ordre', 'error'); return; }
  const qty = order.remaining, price = order.price;
  const escrow = myRole === 'buy' ? price * qty : (100 - price) * qty;
  const maxGain = myRole === 'buy' ? (100 - price) * qty : price * qty;
  if (!confirm('⚠️ Confirmer le match ?\n\nGain max: +' + maxGain + '€\nPerte max: -' + escrow + '€')) return;
  if ((currentProfile.shares || 0) < escrow) { toast('Solde insuffisant. Requis: ' + escrow + ' shares', 'error'); return; }
  await sb.from('profiles').update({ shares: currentProfile.shares - escrow }).eq('id', currentUser.id);
  await sb.from('orders').update({ status: 'matched', remaining: 0 }).eq('id', orderId);
  const buyer = myRole === 'buy' ? currentUser.id : order.user_id;
  const seller = myRole === 'sell' ? currentUser.id : order.user_id;
  const buyerPseudo = myRole === 'buy' ? currentProfile.pseudo : order.pseudo;
  const sellerPseudo = myRole === 'sell' ? currentProfile.pseudo : order.pseudo;
  await sb.from('trades').insert({ buyer_id: buyer, seller_id: seller, buyer_pseudo: buyerPseudo, seller_pseudo: sellerPseudo, team_id: order.team_id, price, qty, escrow_buyer: price * qty, escrow_seller: (100 - price) * qty, status: 'open' });
  await sb.from('market_prices').upsert({ team_id: order.team_id, last_price: price }, { onConflict: 'team_id' });
  await sb.from('notifications').insert({ user_id: order.user_id, msg: '✅ Ordre ' + order.side.toUpperCase() + ' ' + order.team_id + ' @' + price + ' matché par ' + currentProfile.pseudo, read: false });
  currentProfile.shares -= escrow;
  updateTopbar(); toast('Match exécuté ✓', 'success');
}

/* ══════ CANCEL ORDER ══════ */
async function cancelOrder(orderId) {
  if (!confirm('Annuler cet ordre et récupérer l\'escrow ?')) return;
  const { data: order } = await sb.from('orders').select('*').eq('id', orderId).single();
  if (!order || order.user_id !== currentUser.id) { toast('Non autorisé', 'error'); return; }
  await sb.from('orders').update({ status: 'cancelled' }).eq('id', orderId);
  await sb.from('profiles').update({ shares: currentProfile.shares + order.escrow }).eq('id', currentUser.id);
  currentProfile.shares += order.escrow;
  updateTopbar(); toast('Ordre annulé, escrow remboursé', 'success');
}

/* ══════ CHAT ══════ */
async function subscribeChat(teamId) {
  await renderChat(teamId);
  chatChannel = sb.channel('chat-' + teamId)
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'chat', filter: 'team_id=eq.' + teamId }, () => renderChat(teamId))
    .subscribe();
}

async function renderChat(teamId) {
  const { data } = await sb.from('chat').select('*').eq('team_id', teamId).order('created_at', { ascending: true }).limit(50);
  const box = document.getElementById('chat-messages');
  if (!box) return;
  box.innerHTML = (data || []).map(m => {
    const isMe = m.user_id === currentUser.id;
    return '<div class="chat-msg' + (isMe ? ' me' : '') + '"><span class="chat-pseudo' + (isMe ? ' green' : '') + '">' + esc(m.pseudo) + '</span><span class="chat-text">' + esc(m.text) + '</span></div>';
  }).join('');
  box.scrollTop = box.scrollHeight;
}

async function sendChat() {
  const inp = document.getElementById('chat-input');
  const text = inp.value.trim();
  if (!text || !selectedTeam) return;
  inp.value = '';
  await sb.from('chat').insert({ user_id: currentUser.id, pseudo: currentProfile.pseudo, team_id: selectedTeam, text });
}

/* ══════ PORTFOLIO ══════ */
async function renderPortfolio() {
  const el = document.getElementById('portfolio-content');
  el.innerHTML = '<div class="loading">Chargement...</div>';
  const [{ data: bt }, { data: st }, { data: oo }, { data: prices }] = await Promise.all([
    sb.from('trades').select('*').eq('buyer_id', currentUser.id).eq('status', 'open'),
    sb.from('trades').select('*').eq('seller_id', currentUser.id).eq('status', 'open'),
    sb.from('orders').select('*').eq('user_id', currentUser.id).eq('status', 'open'),
    sb.from('market_prices').select('*')
  ]);
  const pricesMap = {};
  (prices || []).forEach(p => pricesMap[p.team_id] = p);
  const trades = [...(bt || []).map(t => ({ ...t, myRole: 'buyer' })), ...(st || []).map(t => ({ ...t, myRole: 'seller' }))];

  let html = '<div class="port-wallet"><div class="pw-label">Solde disponible</div>' +
    '<div class="pw-val">' + (currentProfile.shares || 0).toLocaleString('fr') + ' <span class="muted mono" style="font-size:20px">shares</span></div>' +
    '<div class="pw-eur muted mono">' + (currentProfile.shares || 0) + '€ équivalent</div></div>';

  if (trades.length) {
    html += '<div class="section-title" style="margin-bottom:12px">Positions ouvertes</div><div class="positions-list">';
    trades.forEach(t => {
      const team = TEAMS.find(x => x.id === t.team_id);
      const last = pricesMap[t.team_id]?.last_price ?? t.price;
      const isBuyer = t.myRole === 'buyer';
      const pnl = isBuyer ? (last - t.price) * t.qty : (t.price - last) * t.qty;
      const maxG = isBuyer ? (100 - t.price) * t.qty : t.price * t.qty;
      const maxL = isBuyer ? t.price * t.qty : (100 - t.price) * t.qty;
      html += '<div class="position-row">' +
        '<div style="flex:2"><span style="font-size:18px">' + (team?.flag || '') + '</span> <strong>' + (team?.name || t.team_id) + '</strong></div>' +
        '<div><span class="side-badge ' + (isBuyer ? 'long' : 'short') + '">' + (isBuyer ? 'LONG' : 'SHORT') + '</span></div>' +
        '<div class="mono muted">@' + t.price + ' × ' + t.qty + '</div>' +
        '<div class="mono muted">Last: ' + last + '</div>' +
        '<div class="mono ' + (pnl >= 0 ? 'green' : 'red') + '">' + (pnl >= 0 ? '+' : '') + pnl.toFixed(0) + '€</div>' +
        '<div class="mono muted" style="font-size:11px">Max +' + maxG + '€ / -' + maxL + '€</div></div>';
    });
    html += '</div>';
  }

  if (oo?.length) {
    html += '<div class="section-title" style="margin:24px 0 12px">Ordres en attente (escrow bloqué)</div><div class="orders-list">';
    oo.forEach(o => {
      const team = TEAMS.find(x => x.id === o.team_id);
      html += '<div class="order-row">' +
        '<div>' + (team?.flag || '') + ' <strong>' + (team?.name || o.team_id) + '</strong></div>' +
        '<div class="mono ' + (o.side === 'buy' ? 'green' : 'red') + '">' + o.side.toUpperCase() + ' @' + o.price + ' × ' + o.remaining + '</div>' +
        '<div class="muted mono">Escrow: ' + o.escrow + ' shares</div>' +
        '<button class="btn btn-xs btn-ghost" onclick="cancelOrder(\'' + o.id + '\')">✕ Annuler</button></div>';
    });
    html += '</div>';
  }
  el.innerHTML = html;
}

/* ══════ HISTORY + NETTING ══════ */
async function renderHistory() {
  const el = document.getElementById('history-content');
  el.innerHTML = '<div class="loading">Chargement...</div>';
  const [{ data: bt }, { data: st }] = await Promise.all([
    sb.from('trades').select('*').eq('buyer_id', currentUser.id).order('created_at', { ascending: false }),
    sb.from('trades').select('*').eq('seller_id', currentUser.id).order('created_at', { ascending: false })
  ]);
  const all = [...(bt || []).map(t => ({ ...t, myRole: 'buyer' })), ...(st || []).map(t => ({ ...t, myRole: 'seller' }))];
  all.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
  if (!all.length) { el.innerHTML = '<p class="muted">Aucun trade pour le moment</p>'; return; }

  const netting = {};
  all.forEach(t => {
    if (t.status !== 'resolved') return;
    const isBuyer = t.myRole === 'buyer';
    const counter = isBuyer ? t.seller_id : t.buyer_id;
    const cPseudo = isBuyer ? t.seller_pseudo : t.buyer_pseudo;
    if (!netting[counter]) netting[counter] = { pseudo: cPseudo, net: 0 };
    const pnl = isBuyer ? (t.resolved_value - t.price) * t.qty : (t.price - t.resolved_value) * t.qty;
    netting[counter].net += pnl;
  });

  let html = '';
  const nList = Object.values(netting).filter(n => n.net !== 0);
  if (nList.length) {
    html += '<h3 class="section-title">💸 Règlement net (trades résolus)</h3><div class="netting-box">';
    nList.forEach(n => {
      const owes = n.net > 0;
      html += '<div class="netting-row"><span class="mono" style="font-weight:600">' + n.pseudo + '</span>' +
        '<span class="mono ' + (owes ? 'green' : 'red') + '">' + (owes ? '→ te doit <strong>' + n.net + '€</strong>' : '← tu lui dois <strong>' + Math.abs(n.net) + '€</strong>') + '</span></div>';
    });
    html += '</div>';
  }

  html += '<h3 class="section-title" style="margin-top:24px">Tous les trades</h3><div class="trade-list">';
  all.forEach(t => {
    const team = TEAMS.find(x => x.id === t.team_id);
    const isBuyer = t.myRole === 'buyer';
    const counter = isBuyer ? t.seller_pseudo : t.buyer_pseudo;
    let pnlStr = t.status === 'resolved'
      ? (() => { const pnl = isBuyer ? (t.resolved_value - t.price) * t.qty : (t.price - t.resolved_value) * t.qty; return '<span class="mono ' + (pnl >= 0 ? 'green' : 'red') + '">' + (pnl >= 0 ? '+' : '') + pnl + '€</span>'; })()
      : '<span class="muted mono">En cours</span>';
    const date = t.created_at ? new Date(t.created_at).toLocaleDateString('fr') : '—';
    html += '<div class="trade-row"><div style="flex:1">' + (team?.flag || '') + ' <strong>' + (team?.name || t.team_id) + '</strong></div>' +
      '<div class="mono ' + (isBuyer ? 'green' : 'red') + '">' + (isBuyer ? 'LONG' : 'SHORT') + ' @' + t.price + '×' + t.qty + '</div>' +
      '<div class="muted">vs ' + counter + '</div><div>' + pnlStr + '</div>' +
      '<div class="muted mono" style="font-size:11px">' + date + '</div></div>';
  });
  html += '</div>';
  el.innerHTML = html;
}

/* ══════ LEADERBOARD ══════ */
