/* ══════ NOTIFICATIONS ══════ */
async function subscribeNotifications() {
  await renderNotifications();
  notifChannel = sb.channel('notifs-' + currentUser.id)
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'notifications', filter: 'user_id=eq.' + currentUser.id }, () => renderNotifications())
    .subscribe();
}

async function renderNotifications() {
  const { data } = await sb.from('notifications').select('*').eq('user_id', currentUser.id).eq('read', false).order('created_at', { ascending: false });
  const badge = document.getElementById('notif-badge');
  const count = data?.length || 0;
  if (badge) { badge.textContent = count > 0 ? count : ''; badge.classList.toggle('hidden', count === 0); }
  const list = document.getElementById('notif-list');
  if (!list) return;
  list.innerHTML = count
    ? data.map(n => '<div class="notif-item" onclick="markRead(\'' + n.id + '\')">' +
        '<div style="font-size:13px">' + n.msg + '</div>' +
        '<div class="muted mono" style="font-size:10px;margin-top:3px">' + new Date(n.created_at).toLocaleString('fr') + '</div></div>').join('')
    : '<div class="muted" style="padding:16px;font-size:13px">Aucune notification</div>';
}

async function markRead(id) {
  await sb.from('notifications').update({ read: true }).eq('id', id);
  renderNotifications();
}

function toggleNotifs() {
  document.getElementById('notif-panel').classList.toggle('hidden');
}

/* ══════ ADMIN ══════ */
async function renderAdmin() {
  if (!currentProfile?.is_admin) return;
  const el = document.getElementById('admin-content');
  el.innerHTML = '<div class="loading">Chargement...</div>';
  const [{ data: pending }, { data: allUsers }, { data: resolved }] = await Promise.all([
    sb.from('profiles').select('*').eq('status', 'pending'),
    sb.from('profiles').select('*').order('shares', { ascending: false }),
    sb.from('resolved_markets').select('*')
  ]);
  const resolvedMap = {};
  (resolved || []).forEach(r => resolvedMap[r.team_id] = r);

  let html = '';

  if (pending?.length) {
    html += '<div class="admin-section"><h3 class="section-title">⏳ Inscriptions en attente (' + pending.length + ')</h3><div class="admin-list">';
    pending.forEach(u => {
      html += '<div class="admin-row"><div><strong>' + u.pseudo + '</strong> — <span class="muted">' + u.email + '</span></div>' +
        '<div class="mono">' + u.pending_eur + '€ → ' + u.pending_shares + ' shares</div>' +
        '<div style="display:flex;gap:8px"><button class="btn btn-xs btn-primary" onclick="approveUser(\'' + u.id + '\')">✅ Valider</button>' +
        '<button class="btn btn-xs btn-danger" onclick="rejectUser(\'' + u.id + '\')">❌ Rejeter</button></div></div>';
    });
    html += '</div></div>';
  }

  html += '<div class="admin-section"><h3 class="section-title">🏁 Résoudre un marché</h3><div class="admin-form">' +
    '<div class="fgroup"><label>Équipe</label><select id="res-team">' +
    TEAMS.map(t => '<option value="' + t.id + '">' + t.flag + ' ' + t.name + (resolvedMap[t.id] ? ' ✓' : '') + '</option>').join('') +
    '</select></div>' +
    '<div class="fgroup"><label>Résolution</label><select id="res-stage">' +
    '<option value="groups">Groupes → 0</option><option value="r16">16e de finale → 10</option>' +
    '<option value="quarter">Quart → 35</option><option value="semi">Demi-finale → 55</option>' +
    '<option value="finalist">Finaliste (2e) → 75</option><option value="champion">Champion 🏆 → 100</option>' +
    '</select></div><button class="btn btn-primary" onclick="resolveMarket()">Résoudre</button></div></div>';

  html += '<div class="admin-section"><h3 class="section-title">💳 Recharge manuelle (Lydia reçu)</h3><div class="admin-form">' +
    '<div class="fgroup"><label>Joueur</label><select id="recharge-uid">' +
    (allUsers || []).filter(u => u.status === 'active').map(u => '<option value="' + u.id + '">' + u.pseudo + '</option>').join('') +
    '</select></div><div class="fgroup"><label>Montant (€)</label><input type="number" id="recharge-eur" value="5" min="5" step="5"></div>' +
    '<button class="btn btn-primary" onclick="doRecharge()">Créditer</button></div></div>';

  html += '<div class="admin-section"><h3 class="section-title">👥 Joueurs actifs</h3><div class="admin-list">';
  (allUsers || []).filter(u => u.status === 'active').forEach(u => {
    html += '<div class="admin-row"><div><strong>' + u.pseudo + '</strong> <span class="muted">' + u.email + '</span></div>' +
      '<div class="mono accent">' + (u.shares || 0).toLocaleString('fr') + ' shares</div></div>';
  });
  html += '</div></div>';
  el.innerHTML = html;
}

async function approveUser(uid) {
  const { data: u } = await sb.from('profiles').select('*').eq('id', uid).single();
  await sb.from('profiles').update({ status: 'active', shares: (u.shares || 0) + (u.pending_shares || 0), pending_shares: 0, pending_eur: 0 }).eq('id', uid);
  await sb.from('notifications').insert({ user_id: uid, msg: '🎉 Compte activé ! +' + u.pending_shares + ' shares crédités. Bienvenue sur Aurel WC !', read: false });
  toast('Joueur validé ✓', 'success'); renderAdmin();
}

async function rejectUser(uid) {
  if (!confirm('Rejeter ce compte ?')) return;
  await sb.from('profiles').update({ status: 'rejected' }).eq('id', uid);
  toast('Compte rejeté', 'success'); renderAdmin();
}

async function doRecharge() {
  const uid = document.getElementById('recharge-uid').value;
  const eur = parseInt(document.getElementById('recharge-eur').value) || 0;
  if (eur < 5) { toast('Minimum 5€', 'error'); return; }
  const shares = eur * SHARES_PER_EUR;
  const { data: u } = await sb.from('profiles').select('shares').eq('id', uid).single();
  await sb.from('profiles').update({ shares: (u.shares || 0) + shares }).eq('id', uid);
  await sb.from('notifications').insert({ user_id: uid, msg: '💳 +' + shares + ' shares crédités (' + eur + '€ reçus)', read: false });
  toast('+' + shares + ' shares crédités ✓', 'success'); renderAdmin();
}

async function resolveMarket() {
  const teamId = document.getElementById('res-team').value;
  const stage = document.getElementById('res-stage').value;
  const value = RESOLUTION[stage];
  const team = TEAMS.find(t => t.id === teamId);
  if (!confirm('Résoudre ' + team?.name + ' — ' + stage + ' — valeur: ' + value + '\n\nCette action est irréversible.')) return;
  const { data: trades } = await sb.from('trades').select('*').eq('team_id', teamId).eq('status', 'open');
  if (!trades?.length) { toast('Aucun trade ouvert sur cette équipe', 'error'); return; }
  for (const t of trades) {
    const buyerPnl = (value - t.price) * t.qty;
    const sellerPnl = (t.price - value) * t.qty;
    const buyerReceives = t.escrow_buyer + buyerPnl;
    const sellerReceives = t.escrow_seller + sellerPnl;
    if (buyerReceives > 0) {
      const { data: bu } = await sb.from('profiles').select('shares').eq('id', t.buyer_id).single();
      await sb.from('profiles').update({ shares: (bu.shares || 0) + buyerReceives }).eq('id', t.buyer_id);
    }
    if (sellerReceives > 0) {
      const { data: su } = await sb.from('profiles').select('shares').eq('id', t.seller_id).single();
      await sb.from('profiles').update({ shares: (su.shares || 0) + sellerReceives }).eq('id', t.seller_id);
    }
    await sb.from('trades').update({ status: 'resolved', resolved_value: value, resolved_stage: stage }).eq('id', t.id);
    await sb.from('notifications').insert([
      { user_id: t.buyer_id, msg: '🏁 ' + team?.name + ' résolu @' + value + '. P&L: ' + (buyerPnl >= 0 ? '+' : '') + buyerPnl + '€', read: false },
      { user_id: t.seller_id, msg: '🏁 ' + team?.name + ' résolu @' + value + '. P&L: ' + (sellerPnl >= 0 ? '+' : '') + sellerPnl + '€', read: false }
    ]);
  }
  await sb.from('resolved_markets').upsert({ team_id: teamId, stage, value }, { onConflict: 'team_id' });
  toast(team?.name + ' résolu @' + value + ' — ' + trades.length + ' trades réglés ✓', 'success');
  renderAdmin(); renderMarkets();
}

/* ══════ UTILS ══════ */
function toast(msg, type = 'info') {
  const t = document.createElement('div');
  t.className = 'toast toast-' + type;
  t.textContent = msg;
  document.getElementById('toast-container').appendChild(t);
  setTimeout(() => t.classList.add('show'), 10);
  setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 300); }, 3200);
}

function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

document.addEventListener('click', e => {
  const panel = document.getElementById('notif-panel');
  if (panel && !panel.classList.contains('hidden') && !panel.contains(e.target) && !e.target.closest('.notif-btn')) {
    panel.classList.add('hidden');
  }
});
</script>
